# Copy to .env (never commit .env). Names only — fill values in your local .env / hosting dashboards.
# `make env` creates a local .env with random keys.
DEMO_MODE=true
DEMO_REF_DATE=2026-11-22            # "today" inside the demo (showcase day)
DATABASE_URL=                       # e.g. postgresql:///reprosense?host=/tmp  (Supabase: its Postgres URL)
ALLOWED_ORIGINS=http://localhost:3000
DEMO_TOKEN_SECRET=                  # random string, signs demo role tokens
NOTES_KEY=                          # base64 of 32 random bytes, AES-256-GCM key for notes and documents
API_URL=http://127.0.0.1:8010       # where the web app reaches the API

# Supabase (production path; the local demo uses plain Postgres with the same schema and RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_AUDIENCE=authenticated

# AI
LLM_PROVIDER=auto                   # auto | claude | none  (auto = Claude when a key is set, else templates)
ANTHROPIC_API_KEY=
EMBEDDINGS_PROVIDER=hashing         # built-in hashing vectors; see QUESTIONS #14

# Status page (issue #30), set on the web host; /status hides each one when unset
STATUS_MONITOR_URL=                 # public page of the uptime monitor on the API's /healthz
SUPPORT_EMAIL=                      # pilot support inbox
