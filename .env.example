# Copy to .env (never commit .env). Names only — fill values in your local .env / hosting dashboards.
# `make env` creates a local .env with random keys.
DEMO_MODE=true
DEMO_REF_DATE=2026-11-22            # "today" inside the demo (showcase day)
DATABASE_URL=                       # e.g. postgresql:///reprosense?host=/tmp  (Supabase: its Postgres URL)
ALLOWED_ORIGINS=http://localhost:3000
DEMO_TOKEN_SECRET=                  # random string, signs demo role tokens
NOTES_KEY=                          # base64 of 32 random bytes, AES-256-GCM key for notes and documents
API_URL=http://127.0.0.1:8010       # where the web app reaches the API

# Hardening (docs/31 §H). Empty = off, behaviour as in development.
EDGE_SECRET=                        # same random value on the web host and the API: only the web's own server may name
                                    # the visitor's address to the API; direct callers count against their real address
DEMO_RESET_KEY=                     # API: the demo reset also needs this operator key (the one-tap admin is public)
EXPOSE_API_DOCS=false               # API: /docs and /openapi.json, for local development only
DEMO_TOKEN_SECRET_PREVIOUS=         # API, during a rotation only: sessions signed with the old secret still verify
NOTES_KEY_PREVIOUS=                 # API, during a rotation only: data under the old key still decrypts

# Supabase (production path; the local demo uses plain Postgres with the same schema and RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_AUDIENCE=authenticated

# AI
LLM_PROVIDER=auto                   # auto | claude | openrouter | none  (auto = Claude, else OpenRouter, when a key is set; else templates)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=                 # hackathon AI credits (programs.upstartbar.com)
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5-20260928   # must be one of the 7 ids allowed for the team key (Upstart participant space); others are switched off
EMBEDDINGS_PROVIDER=hashing         # built-in hashing vectors; see QUESTIONS #14

# Her own sign-in (K5). Passkeys work with no key: the relying party defaults to the host of the first ALLOWED_ORIGINS
# entry. The email code backup is hidden until RESEND_API_KEY is set (the API answers 503 without it).
WEBAUTHN_RP_ID=                     # optional, e.g. reprosense.vercel.app (default: host of ALLOWED_ORIGINS)
WEBAUTHN_ORIGINS=                   # optional, comma-separated (default: ALLOWED_ORIGINS)
RESEND_API_KEY=                     # resend.com API key; sends the 6-digit sign-in code
EMAIL_FROM=                         # sender on a domain verified in Resend, e.g. ReproSense <signin@your-domain>

# Staff and DoH sign-in (plan section 5). Optional: these are the defaults. DoH admins are made with the
# operator CLI (cd backend && uv run python -m app.security.create_doh_admin --setup doh-01), never by sign-up.
STAFF_IDLE_MINUTES=30               # a staff or DoH session ends after this many minutes without a request
STAFF_SESSION_MAX_MINUTES=480       # 8 hours at most, however busy
STEP_UP_MINUTES=5                   # an export needs a passkey check (demo: a one-tap confirm) this recent
SETUP_LINK_HOURS=24                 # how long a DoH admin's single-use setup link works

# Status page (issue #30), set on the web host; /status hides each one when unset
STATUS_MONITOR_URL=                 # public page of the uptime monitor on the API's /healthz
SUPPORT_EMAIL=                      # pilot support inbox
